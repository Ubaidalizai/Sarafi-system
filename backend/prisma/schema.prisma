// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  admin
  cashier
  accountant
}

enum SlipStatus {
  issued
  paid
  cancelled
  expired
}

/** Desk / office handling of a slip (can be changed anytime). */
enum SlipReviewStatus {
  waiting
  confirmed
  rejected
}

enum PartnerTxDirection {
  in
  out
}

enum ReconciliationStatus {
  pending
  confirmed
  disputed
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(cashier)
  isActive     Boolean  @default(true)

  exchanges ExchangeTransaction[] @relation("ExchangeCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  code String @id // AFN, USD, IRR, PKR, TOMAN, ...
  name String
  isActive Boolean @default(true)

  accounts CustomerAccount[]
  deposits DepositTransaction[]
  slips Slip[]
  partnerAccounts PartnerAccount[]
  partnerTransactions PartnerTransaction[]
  fundingRepayments FundingAccountRepayment[]
}

model Customer {
  id        String  @id @default(cuid())
  fullName  String
  phone     String?
  idNumber  String?
  notes     String?

  accounts  CustomerAccount[]
  deposits  DepositTransaction[]
  slips     Slip[]
  exchanges ExchangeTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExchangeTransaction {
  id                  String  @id @default(cuid())
  referenceNo         String  @unique
  clientReference     String? @unique
  customerId          String
  fromCurrencyCode    String
  toCurrencyCode      String
  sourceAmount        Decimal
  rate                Decimal
  targetAmountGross   Decimal
  feeAmount           Decimal
  targetAmountNet     Decimal
  status              String  @default("posted")
  ledgerBatchId       String
  notes               String?
  createdById         String

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("ExchangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerAccount {
  id String @id @default(cuid())

  customerId String
  currencyCode String
  balance Decimal @default(0)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, currencyCode])
}

model DepositTransaction {
  id String @id @default(cuid())
  customerId String
  currencyCode String
  amount Decimal
  note String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  createdAt DateTime @default(now())
}

model Slip {
  id String @id @default(cuid())
  slipCode String @unique
  customerId String
  currencyCode String
  amount Decimal
  /** Source-of-funds desk account (e.g. lender / Kata); slip list shows this name. */
  fundingAccountId String?
  /** When set, cash for this slip is drawn from this partner balance (not a funding desk account). */
  partnerAccountId String?
  receiverName String?
  /** Person/counterparty to whom cash is paid (distinct from bank account label). */
  paidToName String?
  note String?
  status SlipStatus @default(issued)
  reviewStatus SlipReviewStatus @default(waiting)
  paidAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  fundingAccount FundingAccount? @relation(fields: [fundingAccountId], references: [id], onDelete: Restrict)
  partnerAccount PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: Restrict)
  /** Ledger line created when a partner-funded slip is paid (one row per slip). */
  partnerPayoutTx PartnerTransaction? @relation("SlipPartnerLedger")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundingAccountId])
  @@index([partnerAccountId])
}

/** External desk account whose cash backs slips (e.g. Abdul Rahman — old Kata). */
model FundingAccount {
  id          String  @id @default(cuid())
  displayName String
  phone       String?
  notes       String?
  isActive    Boolean @default(true)

  slips       Slip[]
  repayments  FundingAccountRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Direct repayment to a funding account (not through a slip). */
model FundingAccountRepayment {
  id               String   @id @default(cuid())
  fundingAccountId String
  currencyCode     String
  amount           Decimal
  note             String?

  fundingAccount FundingAccount @relation(fields: [fundingAccountId], references: [id], onDelete: Restrict)
  currency       Currency       @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([fundingAccountId])
}

model Partner {
  id String @id @default(cuid())
  name String
  country String?
  city String?
  contact String?
  notes String?

  accounts PartnerAccount[]
  transactions PartnerTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnerAccount {
  id String @id @default(cuid())
  partnerId String
  currencyCode String
  balance Decimal @default(0)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  slips Slip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, currencyCode])
}

model PartnerTransaction {
  id String @id @default(cuid())
  partnerId String
  currencyCode String
  amount Decimal
  direction PartnerTxDirection
  beneficiaryName String?
  referenceNo String?
  note String?
  reconciliationStatus ReconciliationStatus @default(pending)
  /** When set, this row was created automatically for slip payout (do not edit/delete manually). */
  slipId String? @unique
  slip Slip? @relation("SlipPartnerLedger", fields: [slipId], references: [id], onDelete: Restrict)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  createdAt DateTime @default(now())
}
